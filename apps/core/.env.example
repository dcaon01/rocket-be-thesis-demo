APP_NAME=rocket-core
REPO_NAME=rocket-core
NODE_ENV=development
# Project tag of the DynamoDB tables: set by the infra in the cloud, unused locally
PROJECT_NAME=rocket
PORT=3154
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=test
DOAMAIN_NAME=http://localhost:3000
# S3 Configuration
# Bucket for file uploads (contracts, product logos)
S3_BUCKET=your-bucket-name
S3_BASE_URL=https://your-bucket-name.s3.amazonaws.com
# Public bucket of the email images: the product logos are copied here for the emails to the companies
EMAIL_ASSETS_BUCKET=rocket-dev-email-assets
EMAIL_ASSETS_BASE_URL=https://rocket-dev-email-assets.s3.eu-north-1.amazonaws.com
# S3 event notifications are received via SQS → Lambda → POST /webhooks/events
SQS_S3_EVENTS_QUEUE_NAME=core-s3-events
SQS_INBOUND_QUEUE_NAME=inbound
SQS_INBOUND_QUEUE_ARN=arn:aws:sqs:your-region:your-account-id:inbound
# EventBridge Configuration
EVENTBRIDGE_BUS_NAME=default
EVENTBRIDGE_SOURCE=rocket
USER_SYNC_QUEUE_URL=test
SWAGGER_TITLE=Rocket Core
ENCRYPTION_KEY=your-encryption-key-here
HUBSPOT_API_URL=https://api.hubapi.com
HUBSPOT_URL=https://app-eu1.hubspot.com
# HubSpot API key (unified across all products)
HUBSPOT_KEY=your-hubspot-api-key-here
# HubSpot client secret for webhook signature verification
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret-here
# HubSpot pipeline holding the deals of every product, told apart by their solution of interest
HUBSPOT_PRODUCTS_PIPELINE_ID=4129198276
# Stripe API key, webhook secret and tax rate id are now stored per-product on the Product
# entity (apiKey/webhookSecret are encrypted at rest). The StripeService no longer reads
# them from env.
STRIPE_API_URL=https://api.stripe.com
# Stripe account of Keus itself, which bills the reseller subscription fees (not tied to any product).
KEUS_STRIPE_API_KEY=
KEUS_STRIPE_WEBHOOK_SECRET=
KEUS_STRIPE_TAX_RATE_ID=
# Mixpanel Export API (raw events, the Query API is not in the Free plan). The project id is stored per-product on the
# Product entity (mixpanelProjectId); only the read-only service-account credentials and the optional base URL live here.
MIXPANEL_SERVICE_ACCOUNT_USERNAME=your-service-account-username
MIXPANEL_SERVICE_ACCOUNT_SECRET=your-service-account-secret
MIXPANEL_API_BASE_URL=https://data-eu.mixpanel.com
# Environment of this Rocket (dev or prod): when set, only the events with the same `environment` property are read.
MIXPANEL_ENVIRONMENT=dev
# Intercom REST API, read only, for the support metrics. The workspace is shared by every product.
INTERCOM_ACCESS_TOKEN=your-intercom-access-token
INTERCOM_API_URL=https://api.intercom.io
# ARN of the IAM role assumed by EventBridge Scheduler to send messages to SQS
SCHEDULER_ROLE_ARN=arn:aws:iam::your-account-id:role/eventbridge-scheduler-sqs-role
# Email - SES sender and the prefix of the SES templates defined in rocket-infra (be/templates/email/)
MAIL_FROM="Rocket <noreply@rockettino.keus.dev>"
MAIL_TEMPLATE_PREFIX=rocket-dev
# Cognito user pool of Rocket collaborators, used to resolve email recipients
COGNITO_USER_POOL_ID=eu-north-1_your-pool-id
# Lambda that turns the HTML documents into PDF (rocket-infra, be/lambda-functions.tf)
RENDER_FUNCTION_NAME=rocket-dev-render
