AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=test
COGNITO_USER_POOL_ID=test
USER_SYNC_QUEUE_URL=test
APP_NAME=rocket-cognito
REPO_NAME=rocket-cognito
NODE_ENV=development
# Project tag of the DynamoDB tables: set by the infra in the cloud, unused locally
PROJECT_NAME=rocket
PORT=3154
SWAGGER_TITLE=Rocket Cognito

# S3 Configuration
# Bucket for user profile photo uploads
S3_BUCKET=your-bucket-name
# S3 event notifications are received via SQS → Lambda → POST /webhooks/events
# The custom attribute 'custom:profilePicS3Key' must be configured in the Cognito User Pool
